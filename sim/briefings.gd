static func get_brief(kind: String) -> Dictionary:
	var d: Dictionary = DATA.get(kind, {})
	var tips: Dictionary = DEFAULT_TIPS.duplicate()
	tips.merge(d.get("tips", {}), true)
	return {"narrator": d.get("narrator", "igor"), "who": d.get("who", "IGOR"), "story": d.get("story", ""), "tips": tips}
